{
    "main": "ohdear",
    "chmod": "0755",
    "directories": [
        "app",
        "bootstrap",
        "config"
    ],
    "files": [
        "composer.json",
        "vendor/phpstan/phpstan/bootstrap.php"
    ],
    "finder": [
        {
            "in": "vendor",
            "exclude": [
                "brianium",
                "larastan",
                "laravel/pint",
                "laravel-zero/framework/bin",
                "phpstan/phpstan"
            ]
        }
    ],
    "exclude-composer-files": false,
    "exclude-dev-files": false,
    "check-requirements": false,
    "compression": "GZ",
    "compactors": [
        "KevinGH\\Box\\Compactor\\Php",
        "KevinGH\\Box\\Compactor\\Json"
    ]
}
